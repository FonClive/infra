# Prometheus Configuration File
# Auto-generated by Ansible

global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_evaluation_interval }}
  
  external_labels:
    environment: '{{ ansible_env|default("dev") }}'
    cluster: 'ec2-infrastructure'

# Scrape Prometheus itself
scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:{{ prometheus_port }}']
        labels:
          instance: 'prometheus-server'
          role: 'monitoring'

  # Scrape all Node Exporters
  - job_name: 'node-exporter'
    static_configs:
      # Frontend servers
{% for host in groups['role_frontend'] | default([]) %}
      - targets: ['{{ hostvars[host].ansible_default_ipv4.address | default(hostvars[host].private_ip_address) }}:9100']
        labels:
          instance: '{{ host }}'
          role: 'frontend'
          environment: '{{ hostvars[host].tags.Environment | default("unknown") }}'
{% endfor %}

      # SonarQube servers
{% for host in groups['role_sonarqube'] | default([]) %}
      - targets: ['{{ hostvars[host].ansible_default_ipv4.address | default(hostvars[host].private_ip_address) }}:9100']
        labels:
          instance: '{{ host }}'
          role: 'sonarqube'
          environment: '{{ hostvars[host].tags.Environment | default("unknown") }}'
{% endfor %}

      # Monitor servers
{% for host in groups['role_monitor'] | default([]) %}
      - targets: ['{{ hostvars[host].ansible_default_ipv4.address | default(hostvars[host].private_ip_address) }}:9100']
        labels:
          instance: '{{ host }}'
          role: 'monitor'
          environment: '{{ hostvars[host].tags.Environment | default("unknown") }}'
{% endfor %}
